<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="my.project.digital_library.HelloController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-section">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="LIVRARIA DIGITAL" style="-fx-text-fill: #4a90e2; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="campoBusca" promptText="Pesquisar na sua biblioteca..." styleClass="search-field" prefWidth="300"/>
                <Button text="+ Importar PDF" onAction="#handleImportarPdf" styleClass="button-import"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="15" prefWidth="200" style="-fx-background-color: #1e1e24; -fx-padding: 20;">
            <Label text="ESTATÍSTICAS" style="-fx-text-fill: #888; -fx-font-size: 12;"/>
            <VBox style="-fx-background-color: #25252b; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="Total de Livros" style="-fx-text-fill: white; -fx-font-size: 11;"/>
                <Label text="--" fx:id="labelTotalLivros" style="-fx-text-fill: #4a90e2; -fx-font-size: 24; -fx-font-weight: bold;"/>
            </VBox>
            <Separator opacity="0.1"/>
            <Label text="Dica: Clique duplo para ler." style="-fx-text-fill: #666; -fx-font-size: 11;" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 15;">
            <TilePane fx:id="gridLivros" hgap="20" vgap="20" prefColumns="4" style="-fx-background-color: transparent;" />
        </ScrollPane>
    </center>

</BorderPane>